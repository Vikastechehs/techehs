# Copy this file to .env and fill it in. Never commit .env.

# Scrape.do API token (rotate the one shared in chat first). Leave empty to run with simulated fares.
SCRAPEDO_TOKEN=

# PostgreSQL connection string. Leave empty to use the built-in local database in ./data (good for testing).
# Example: postgres://user:password@localhost:5432/flightdeals
DATABASE_URL=

# Market to scan and publish for (only IN is seeded for now)
MARKET=IN

# Searches run at the same time (tested up to 80 with Scrape.do)
CONCURRENCY=50

# Website
SITE_NAME=Flight Deals
PORT=3000
PUBLIC_URL=http://localhost:3000
# Password for /admin (user name is "admin")
ADMIN_PASSWORD=change-me

# Optional: wrap booking links in your affiliate link. {url} is replaced by the encoded Skyscanner URL.
# Example: https://skyscanner.pxf.io/c/XXXX/YYYY/13416?u={url}
AFFILIATE_URL_TEMPLATE=

# Optional: post approved deals to a Telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Users and messaging ---
# Long random value; signs unsubscribe links. setup.bat fills it in.
APP_SECRET=
SESSION_DAYS=60
# Email (login codes, alerts) through resend.com. Empty = messages are only stored in the outbox table (fine for testing).
EMAIL_FROM=Faresight <deals@example.com>
RESEND_API_KEY=
# WhatsApp Cloud API (Meta) for personal WhatsApp alerts
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Telegram bot user name (without @) for "Connect Telegram" links; uses TELEGRAM_BOT_TOKEN above
TELEGRAM_BOT_USERNAME=
# Web push (app notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Hotels ---
HOTELS_ENABLED=true
# mock (simulated) or scrapedo (Google Hotels through Scrape.do; uses SCRAPEDO_TOKEN)
HOTEL_SOURCE=
# Optional: wrap hotel booking links in your affiliate link. {url} is replaced by the encoded Booking.com URL.
HOTEL_AFFILIATE_URL_TEMPLATE=
