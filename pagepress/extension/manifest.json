{
  "manifest_version": 3,
  "name": "PagePress - Clear PDF and JPEG Capture",
  "version": "0.8.0",
  "description": "Capture document sheets at high resolution as one paginated PDF or separate JPEG images.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "downloads"],
  "optional_host_permissions": ["https://api.lemonsqueezy.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open PagePress", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "index.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
