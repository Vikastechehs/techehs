PUBLIC_URL=https://licenses.yourdomain.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
RAZORPAY_PLAN_ID_INR=plan_xxxxxxxxxxxxxx
# RAZORPAY_PLAN_ID_USD=plan_xxxxxxxxxxxxxx
# One-time passes, amounts in paise/cents (no decimals). Leave out a pass to not sell it.
PASS_WEEK_INR=24900
PASS_MONTH_INR=44900
# PASS_WEEK_USD=299
# PASS_MONTH_USD=499
ACTIVATION_LIMIT=2
# Only for regional pricing (INR cheaper than USD): refund international cards on the INR plan.
# INR_INDIAN_PAYMENTS_ONLY=1
DATABASE_PATH=./data/pagepress.sqlite
TRUST_PROXY=1
SELLER_NAME=PagePress
SUPPORT_EMAIL=support@yourdomain.com
